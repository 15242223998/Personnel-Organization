    <shape type="text" topLeftX="64" topLeftY="498" width="500" height="18">
      <content textType="caption" fontSize="9" color="rgba(140,152,166,1)" wrap="false"><p>高校干部人事组织管理系统 · 答辩汇报</p></content>
    </shape>
    <shape type="text" topLeftX="820" topLeftY="498" width="76" height="18">
      <content textType="caption" fontSize="9" color="rgba(140,152,166,1)" textAlign="right" wrap="false"><p>06 / 22</p></content>
    </shape>
